# python
__pycache__/
.venv/
*.pyc

# data + tokenizers (regenerate with data/prepare.py)
data/*.bin
data/*.txt
data/*.json
# ...except the 4096 tokenizer: model.bin below is useless without the exact
# tokenizer it was trained with, so this one 259KB file ships with the repo.
!data/bpe4096.json

# training outputs -- the 4096/2000-step checkpoint ships so a clone can
# re-export or fine-tune without a 21-minute train. See firmware/model/README.md.
runs/*
!runs/ple-jetson-s0.pt
!runs/ple-jetson-s0.json

# generated firmware artifacts (regenerate with src/export.py, src/gen_assets.py)
# model.bin + golden ship with the repo: they are what all three runtimes read,
# and golden.txt is the correctness reference every port is checked against.
firmware/esp32_llm/vocab.h

# raw video / recordings (demo footage — keep out of the repo)
video/
videos/
*.mp4
*.mov
*.MOV
*.MP4

# jetson CUDA build artifacts
firmware/jetson/verify_cuda
firmware/jetson/bench_cuda
firmware/jetson/generate_cuda
firmware/jetson/vocab.h
firmware/jetson/check_tok
firmware/jetson/tok_ref.txt

# samples build artifacts
samples/cpu/matvec_ladder
samples/cpu/numerics

# host_verify build artifacts
firmware/host_verify/verify_c
firmware/host_verify/ppl_c

# skill library cloned in for reference, not part of this repo
claude-skills/
